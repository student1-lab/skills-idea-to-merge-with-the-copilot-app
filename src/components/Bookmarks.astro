---
// Bookmarks component.
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// runs ONLY in the client-side <script> boundary at the bottom of this file.
// Astro runs that script in the browser, never during the build, so
// browser-only APIs (like localStorage) are safe there. The pure helpers it
// relies on live in src/lib/bookmarks.ts, which has no browser dependencies
// and is unit-tested separately (src/lib/bookmarks.test.ts).
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  //
  // Because this code lives in a client <script>, browser storage APIs are
  // safe to use here without breaking the static build. All the pure logic
  // (URL normalizing, slug generation, storage parsing, formatting) is
  // imported from ../lib/bookmarks so it can be unit-tested without a
  // browser.
  import {
    STORAGE_KEY,
    generateSlug,
    normalizeUrl,
    parseStoredBookmarks,
    type Bookmark,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const emptyState = document.getElementById('empty-state') as HTMLElement | null;
  const listHeader = document.getElementById('list-header') as HTMLElement | null;
  const list = document.getElementById('bookmark-list') as HTMLElement | null;
  const clearAllButton = document.getElementById('clear-all') as HTMLButtonElement | null;

  /** Reads and validates the saved bookmarks. Never throws. */
  function loadBookmarks(): Bookmark[] {
    let raw: string | null = null;
    try {
      raw = localStorage.getItem(STORAGE_KEY);
    } catch {
      // Storage can be unavailable (private browsing, disabled, quota, etc).
      return [];
    }
    return parseStoredBookmarks(raw);
  }

  /** Persists the bookmarks list. Silently no-ops if storage is unavailable. */
  function saveBookmarks(bookmarks: Bookmark[]): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // Ignore — e.g. storage full or disabled. The in-memory render still
      // reflects the attempted change for this page view.
    }
  }

  function render(): void {
    if (!list || !emptyState || !listHeader) return;

    const bookmarks = loadBookmarks();
    list.innerHTML = '';

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;

    for (const bookmark of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      // Exact visible separator between the URL and the slug, e.g.
      // "https://www.example.com :: mona-7fk2".
      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.setAttribute('aria-hidden', 'true');
      separator.textContent = ' :: ';

      const slugBadge = document.createElement('span');
      slugBadge.className = 'slug';
      slugBadge.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          const original = copyButton.textContent;
          copyButton.textContent = 'Copied!';
          setTimeout(() => {
            copyButton.textContent = original;
          }, 1500);
        } catch {
          // Clipboard access can fail (e.g. insecure context); ignore silently.
        }
      });

      li.append(link, separator, slugBadge, copyButton);
      list.append(li);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this — stops the page from reloading, even if something below throws

    try {
      const normalized = normalizeUrl(urlInput?.value ?? '');
      if (!normalized) {
        urlInput?.setCustomValidity('Please enter a valid URL.');
        urlInput?.reportValidity();
        return;
      }
      urlInput?.setCustomValidity('');

      const bookmarks = loadBookmarks();
      const slug = generateSlug(bookmarks.map((b) => b.slug));
      bookmarks.push({ url: normalized, slug });
      saveBookmarks(bookmarks);
      render();

      form.reset();
      urlInput?.focus();
    } catch {
      // Defensive: never let an unexpected error bubble up to a native
      // submit/page reload. The URL the user typed is simply not saved.
    }
  });

  clearAllButton?.addEventListener('click', () => {
    if (!confirm('Remove all saved bookmarks?')) return;
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      // Ignore — storage may already be unavailable.
    }
    render();
  });

  render();
</script>
